# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for redirects)
NEXT_PUBLIC_SITE_URL=https://aguirremoderntile.com

# Resend (email notifications for form submissions)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Aguirre Modern Tile <noreply@aguirremoderntile.com>
CONTACT_FORM_TO_EMAIL=vin@moderntile.pro

# Google Analytics (optional - GA4 Measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe (for sending invoices and collecting payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret: create webhook at https://dashboard.stripe.com/webhooks
# pointing to https://yourdomain.com/api/stripe/webhook
# Events to listen for: invoice.paid, invoice.payment_failed, invoice.overdue
STRIPE_WEBHOOK_SECRET=whsec_...

# Google review requests (/api/cron/review-requests + completion email)
# MUST be a "write a review" DEEP LINK, not a maps listing URL. A listing URL
# drops the customer on the profile and they have to hunt for the review button.
# Get it from business.google.com -> your profile -> "Ask for reviews" -> copy link.
# Accepted shapes:
#   https://g.page/r/<PLACE_ID>/review
#   https://search.google.com/local/writereview?placeid=<PLACE_ID>
#   https://maps.app.goo.gl/<SHORT>
# If unset or malformed, NO review asks go out (fail closed) and Discord says so.
GOOGLE_REVIEW_URL=

# Review request tuning (all optional — defaults in parentheses)
REVIEW_REQUEST_MIN_AGE_DAYS=2       # wait this long after the job wraps (2)
REVIEW_REQUEST_MAX_AGE_DAYS=30      # never ask about jobs older than this (30)
REVIEW_REQUEST_NUDGE_AFTER_DAYS=5   # gap before the single follow-up nudge (5)
REVIEW_REQUEST_MAX_PER_RUN=5        # hard cap on texts per run (5)

# Cron auth — required by every /api/cron/* route (fails closed if unset)
CRON_SECRET=some-long-random-string

# Discord ops webhook for daily cron summaries (optional; no-op if unset)
DISCORD_OPS_WEBHOOK=
