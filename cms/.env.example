# Database — Supabase PostgreSQL (use POOLER connection, port 6543, for production)
# Local dev can use the direct connection (port 5432)
DATABASE_URI=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Payload secret — generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-32-character-random-secret-here

# Vercel Blob storage token (production only — get from Vercel → Storage → Blob)
# If unset locally, media uploads fall back to cms/public/media on disk
BLOB_READ_WRITE_TOKEN=

# Optional: Next.js env (Vercel sets this automatically in prod)
# NODE_ENV=development
